[Unit]
# User systemd unit for the Go RomM server. Install to
# ~/.config/systemd/user/romm-go.service, `systemctl --user daemon-reload`,
# then `systemctl --user enable --now romm-go`. Runs alongside the container
# until you cut Caddy over to it. (If it must survive logout without a login
# session, `loginctl enable-linger $USER`.)
Description=RomM (Go rewrite) server
After=network-online.target
Wants=network-online.target

[Service]
# Build once:  (cd /home/xiam/romm-fork/go-server && go build -o bin/romm-go ./cmd/romm)
ExecStart=/home/xiam/romm-fork/go-server/bin/romm-go
Restart=on-failure
RestartSec=3

# --- environment (same values the container uses; secrets via EnvironmentFile) ---
Environment=ROMM_GO_ADDR=:8099
Environment=DB_HOST=192.168.1.201
Environment=DB_PORT=3306
Environment=DB_USER=romm-user
Environment=DB_NAME=romm
Environment=ROMM_BASE_PATH=/media/8TB/Retro/.romm

# ROMM_WEB_ROOT: the real built Vue dist + EmulatorJS/player assets. The ES-DE
# container serves it from /var/www/html; copy it to a host path the service can
# read (e.g. `podman cp romm:/var/www/html/. /home/xiam/romm/go-webroot/`), or
# point at wherever the dist lives on disk.
Environment=ROMM_WEB_ROOT=/home/xiam/romm/go-webroot

# ROMM_LIBRARY_ROMS_DIR: REQUIRED on this host. The DB's fs_path is "roms/<slug>"
# relative to the library roms root. In the container that root is an overlay at
# ROMM_BASE_PATH/library/roms, but on the HOST the real files live at the ES-DE
# source. Without this, ROM download/play (content serving) 404s.
Environment=ROMM_LIBRARY_ROMS_DIR=/media/8TB/Retro/roms

# ROMM_CONFIG_FILE: path to RomM's config.yml, which drives the Settings UI
# (exclusion lists, scan priorities, EmulatorJS + converto settings, platform
# bindings). Defaults to ROMM_BASE_PATH/config/config.yml, but on this host the
# config dir is a bind the container sees at that path while the host reaches it
# elsewhere — point it at the host path, or the UI shows "config file not
# mounted" and every config-driven setting is blank.
Environment=ROMM_CONFIG_FILE=/home/xiam/romm/config/config.yml

# Secrets + optional integrations — keep out of the unit:
# EnvironmentFile=/home/xiam/romm/go-server.env   (DB_PASSWD, ROMM_AUTH_SECRET_KEY)
#   DB_PASSWD=...
#   ROMM_AUTH_SECRET_KEY=...            # same key the container signs tokens with
#   IGDB_CLIENT_ID=...  IGDB_CLIENT_SECRET=...     # metadata search (IGDB)
#   SCREENSCRAPER_DEV_ID=...  SCREENSCRAPER_DEV_PASSWORD=...   # ScreenScraper (primary)
#   SCREENSCRAPER_USER=...    SCREENSCRAPER_PASSWORD=...       # user acct (raises quota)
#   RETROACHIEVEMENTS_API_KEY=...                  # achievements
#   ROMM_DOWNLOADER_CONFIG=/home/xiam/RommDownloader/config.yaml   # in-process downloads
#   OIDC_ENABLED=true  OIDC_CLIENT_ID=...  OIDC_CLIENT_SECRET=...   # optional SSO
#     OIDC_SERVER_METADATA_URL=...  OIDC_REDIRECT_URI=...

[Install]
WantedBy=default.target
